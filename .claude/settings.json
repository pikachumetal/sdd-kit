{
  "extraKnownMarketplaces": {
    "sdd-kit": {
      "source": { "source": "github", "repo": "pikachumetal/sdd-kit" },
      "autoUpdate": true
    },
    "superpowers-marketplace": {
      "source": { "source": "github", "repo": "obra/superpowers-marketplace" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "sdd-kit@sdd-kit": true,
    "superpowers@superpowers-marketplace": true,
    "plugin-dev@claude-plugins-official": true,
    "code-craftsmanship@wondelai-skills": true,
    "systems-architecture@wondelai-skills": true
  },
  "autoMemoryEnabled": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/kit-session-source.mjs\"",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
