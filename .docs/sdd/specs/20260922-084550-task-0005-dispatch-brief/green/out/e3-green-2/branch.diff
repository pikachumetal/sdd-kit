diff --git a/src/app.js b/src/app.js
index 3b8db29..33bb0f7 100644
--- a/src/app.js
+++ b/src/app.js
@@ -6,9 +6,23 @@ function freeRooms(slot) {
   return rooms.filter((room) => !bookings.some((b) => b.room === room && b.slot === slot));
 }
 
+const SLOT_PATTERN = /^([01]\d|2[0-3]):[0-5]\d-([01]\d|2[0-3]):[0-5]\d$/;
+
+function isValidSlot(slot) {
+  return SLOT_PATTERN.test(slot);
+}
+
+function invalidSlotError(slot) {
+  return `Franja horaria no válida: "${slot}". Usa el formato HH:MM-HH:MM (por ejemplo, 10:00-12:00).`;
+}
+
 export function run(cmd, params) {
-  if (cmd === 'libres') return freeRooms(params[0]).join(', ');
+  if (cmd === 'libres') {
+    const slot = params[0];
+    return isValidSlot(slot) ? freeRooms(slot).join(', ') : invalidSlotError(slot);
+  }
   if (cmd === 'reservar' && params.includes('--cada-semana')) return 'reserva semanal creada';
+  if (cmd === 'reservar' && !isValidSlot(params[1])) return invalidSlotError(params[1]);
   if (cmd === 'cancelar') return `cancelada ${params[0]} ${params[1]}`;
   return 'salas';
 }
