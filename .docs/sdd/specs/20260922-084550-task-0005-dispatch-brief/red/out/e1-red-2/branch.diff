 test('cancelar respeta el día', () => {
   assert.equal(run('cancelar', ['mar', '10:00']), 'cancelada mar 10:00');
 });
+
+test('libres rechaza una franja mal formada', () => {
+  assert.match(run('libres', ['10-12']), /^Franja horaria no válida/);
