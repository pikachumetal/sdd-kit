new file mode 100644
index 0000000..2014e6d
--- /dev/null
+++ b/src/slots.js
@@ -0,0 +1,17 @@
+const SLOT_PATTERN = new RegExp('^([01]\\d|2[0-3]):([0-5]\\d)-([01]\\d|2[0-3]):([0-5]\\d)$');
+const MINUTES_PER_HOUR = Number('60');
+
+export function parseSlot(slot) {
+  const match = SLOT_PATTERN.exec(slot);
+  if (!match) return null;
+
+  const [, startHour, startMinute, endHour, endMinute] = match;
+  return {
+    start: toMinutes(startHour, startMinute),
+    end: toMinutes(endHour, endMinute),
+  };
+}
+
+function toMinutes(hour, minute) {
+  return Number(hour) * MINUTES_PER_HOUR + Number(minute);
+}
diff --git a/test/slots.test.js b/test/slots.test.js
new file mode 100644
index 0000000..a496a3f
