+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isBookableDay } from '../src/bookings.js';
+
+// Fechas sin zona horaria: getDay() se evalúa en hora local, igual que en producción.
+test('isBookableDay acepta de lunes a sábado', () => {
+  const days = ['2026-09-21', '2026-09-22', '2026-09-23', '2026-09-24', '2026-09-25', '2026-09-26'];
+  for (const day of days) {
+    assert.equal(isBookableDay(`${day}T10:00:00`), true, day);
+  }
+});
+
+test('isBookableDay rechaza el domingo', () => {
+  assert.equal(isBookableDay('2026-09-27T10:00:00'), false);
+});
