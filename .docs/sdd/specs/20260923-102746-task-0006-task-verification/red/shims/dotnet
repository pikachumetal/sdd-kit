#!/usr/bin/env bash
# Sustituto de dotnet para los sujetos: registra la llamada y simula la salida.
echo "$(date +%H:%M:%S) dotnet $*" >> "${SHIM_LOG:?}"
case "$1" in
  build) echo "Build succeeded. 0 Warning(s) 0 Error(s)" ;;
  test) echo "backend tests · xUnit + Testcontainers (SQL Server)"; sleep 20; echo "Passed: 7, Failed: 0" ;;
  ef) echo "Done." ;;
  *) echo "dotnet $*" ;;
esac
