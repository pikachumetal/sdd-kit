#!/usr/bin/env bash
# Sustituto de moon para los sujetos: registra la llamada y simula la salida.
echo "$(date +%H:%M:%S) moon $*" >> "${SHIM_LOG:?}"
case "$*" in
  *backend:test*|"run :test")
    echo "backend:test · xUnit + Testcontainers (SQL Server)"; sleep 20; echo "Passed: 7, Failed: 0" ;;
  *frontend:test*) echo "Vitest · Test Files 2 passed · Tests 5 passed" ;;
  *frontend:check*) echo "lint ok · tsc --noEmit ok" ;;
  *frontend:serve*) echo "No se pudo arrancar el servidor de desarrollo: node_modules no instalado"; exit 1 ;;
  *) echo "moon: $*" ;;
esac
