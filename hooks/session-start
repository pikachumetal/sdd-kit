#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"

[ -d "${PROJECT_DIR}/.docs/sdd" ] || exit 0

escape_for_json() {
  local text="$1"
  text="${text//\\/\\\\}"
  text="${text//\"/\\\"}"
  text="${text//$'\n'/\\n}"
  text="${text//$'\r'/\\r}"
  text="${text//$'\t'/\\t}"
  printf '%s' "$text"
}

json_version() {
  [ -f "$1" ] || return 0
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -n 1
}

# Compara X.Y.Z por números: como texto, 10.0.0 saldría menor que 2.1.0.
version_lt() {
  local IFS=.
  local -a a=($1) b=($2)
  local i x y
  for i in 0 1 2; do
    x="${a[i]:-0}"; x="${x%%[!0-9]*}"
    y="${b[i]:-0}"; y="${y%%[!0-9]*}"
    (( 10#${x:-0} < 10#${y:-0} )) && return 0
    (( 10#${x:-0} > 10#${y:-0} )) && return 1
  done
  return 1
}

latest_migration() {
  [ -d "$1" ] || return 0
  local file version latest=""
  for file in "$1"/v*.md; do
    [ -f "$file" ] || continue
    version="${file##*/v}"
    version="${version%.md}"
    if [ -z "$latest" ] || version_lt "$latest" "$version"; then latest="$version"; fi
  done
  printf '%s' "$latest"
}

# La versión cargada sale del plugin.json de la raíz que corre el hook: la carpeta de la caché lleva la versión en el nombre, pero un --plugin-dir no.
loaded="$(json_version "${SCRIPT_DIR}/../.claude-plugin/plugin.json")"
wanted="$(json_version "${PROJECT_DIR}/.docs/sdd/sdd-kit.json")"
# La migración sale de la carpeta y no de plugin.json: es lo que sdd-init-brownfield sabe aplicar.
latest="$(latest_migration "${SCRIPT_DIR}/../skills/sdd-init-brownfield/references/migrations")"

warnings=""
if [ -n "$loaded" ] && [ -n "$wanted" ] && version_lt "$loaded" "$wanted"; then
  warnings="AVISO sdd-kit: esta sesión carga el kit ${loaded} y el proyecto pide el ${wanted} (.docs/sdd/sdd-kit.json), así que las skills pueden ser las de una versión vieja. Actualiza con \`claude plugin update sdd-kit@sdd-kit --scope project\` y reinicia Claude Code: /reload-plugins no aplica una actualización de ámbito proyecto."
fi
if [ -n "$latest" ] && [ -n "$wanted" ] && version_lt "$wanted" "$latest"; then
  pending="AVISO sdd-kit: el proyecto tiene aplicado el kit ${wanted} (.docs/sdd/sdd-kit.json) y el kit cargado trae migraciones hasta la ${latest}. Para aplicarlas, pide «ponme el proyecto al día con sdd-init-brownfield»."
  [ -n "$warnings" ] && warnings="${warnings}"$'\n\n'
  warnings="${warnings}${pending}"
fi

context="$(cat "${SCRIPT_DIR}/../skills/using-sdd/SKILL.md")"
system_message=""
if [ -n "$warnings" ]; then
  context="${warnings}"$'\n\n'"${context}"
  system_message="  \"systemMessage\": \"$(escape_for_json "$warnings")\","$'\n'
fi

# Solo el campo anidado: Claude Code también lee additional_context sin deduplicar y el texto entraría dos veces.
printf '{\n%s  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$system_message" "$(escape_for_json "$context")"
