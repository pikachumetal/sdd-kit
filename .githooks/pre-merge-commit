#!/usr/bin/env node
// git no ejecuta pre-commit en un merge que se cierra solo: delega en él para que la suite corra sobre el commit de merge
const { spawnSync } = require('node:child_process');
const { join } = require('node:path');

process.exit(spawnSync(process.execPath, [join(__dirname, 'pre-commit')], { stdio: 'inherit' }).status ?? 1);
