#!/bin/sh
# Activar una vez por clon: git config core.hooksPath .githooks
if ! command -v pwsh >/dev/null 2>&1; then
  echo "Commit bloqueado: la suite del kit necesita pwsh (PowerShell 7+) en PATH."
  exit 1
fi
pwsh -NoProfile -Command '$result = Invoke-Pester -Path tests -PassThru -Output Minimal; exit $result.FailedCount'
if [ "$?" -ne 0 ]; then
  echo "Commit bloqueado: la suite del kit tiene fallos. Ejecuta: pwsh -NoProfile -Command \"Invoke-Pester -Path tests -Output Detailed\""
  exit 1
fi
