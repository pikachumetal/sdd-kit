#!/usr/bin/env node
// Activar una vez por clon: git config core.hooksPath .githooks
// CommonJS: sin extensión y sin "type" en package.json, Node lo carga así sin re-parsear.
const { execFileSync, spawnSync } = require('node:child_process');

// Git exporta estas variables a sus hooks y ganan a `git -C`: heredadas, un `git init` de un test reinicializa el repo
// común con core.bare = true. Si git no da la lista, execFileSync lanza y el commit se bloquea: nunca corre el gate sin limpiar.
const gitEnvNames = execFileSync('git', ['rev-parse', '--local-env-vars'], { encoding: 'utf8' }).split(/\r?\n/);
const env = Object.fromEntries(Object.entries(process.env).filter(([name]) => !gitEnvNames.includes(name.toUpperCase())));

const checks = ['run', 'cli:typecheck', 'cli:test', 'kit:roadmap'];
const result = spawnSync('moon', checks, { stdio: 'inherit', env });
if (result.error?.code === 'ENOENT') {
  console.log('Commit bloqueado: falta moon; instálalo con «proto install» en la raíz del repo');
  process.exit(1);
}
if (result.status !== 0) {
  console.log(`Commit bloqueado: fallan las comprobaciones del kit. Ejecuta: moon ${checks.join(' ')}`);
  process.exit(1);
}
