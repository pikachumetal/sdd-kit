#!/bin/sh
# Activar una vez por clon: git config core.hooksPath .githooks
if ! command -v moon >/dev/null 2>&1; then
  echo "Commit bloqueado: falta moon; instálalo con «proto install» en la raíz del repo"
  exit 1
fi
if ! moon run cli:typecheck cli:test kit:test-fast kit:roadmap; then
  echo "Commit bloqueado: fallan las comprobaciones del kit. Ejecuta: moon run cli:typecheck cli:test kit:test-fast kit:roadmap"
  exit 1
fi
